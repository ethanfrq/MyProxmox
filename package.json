{
  "name": "myproxmox",
  "version": "2.0.0",
  "description": "Interface web simple pour Proxmox VE, avec écran de monitoring, alertes et serveur MCP pour Claude.",
  "license": "MIT",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "dev": "node scripts/dev.mjs",
    "build": "npm run build:web && npm run build:server",
    "build:web": "vite build --config web/vite.config.ts",
    "build:server": "node scripts/build-server.mjs",
    "build:demo": "vite build --config web/vite.config.ts --mode demo",
    "start": "node server/dist/index.js",
    "demo": "node scripts/demo.mjs",
    "typecheck": "tsc --noEmit -p tsconfig.json"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "1.32.2",
    "express": "5.1.0",
    "ws": "8.22.1",
    "zod": "3.25.76"
  },
  "devDependencies": {
    "@novnc/novnc": "1.7.0",
    "@playwright/test": "1.64.1",
    "@types/express": "5.0.3",
    "@types/node": "22.15.30",
    "@types/react": "19.1.12",
    "@types/react-dom": "19.1.9",
    "@types/ws": "8.18.2",
    "@vitejs/plugin-react": "4.7.0",
    "@xterm/addon-fit": "0.11.0",
    "@xterm/xterm": "6.0.0",
    "esbuild": "0.25.9",
    "react": "19.1.1",
    "react-dom": "19.1.1",
    "react-router-dom": "6.30.1",
    "typescript": "5.9.2",
    "vite": "6.4.1"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/ethanfrq/MyProxmox.git"
  },
  "homepage": "https://github.com/ethanfrq/MyProxmox",
  "author": "Ethan Franqueville",
  "keywords": [
    "proxmox",
    "proxmox-ve",
    "homelab",
    "dashboard",
    "monitoring",
    "mcp",
    "claude",
    "self-hosted"
  ]
}
